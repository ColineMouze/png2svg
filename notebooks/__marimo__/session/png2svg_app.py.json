          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h1 id=\"png-to-svg-converter\">PNG to SVG Converter</h1>\n<span class=\"paragraph\">Convert a PNG image into an SVG image composed of colored hexagons.</span>\n<h2 id=\"how-to-use-this-application\">How to use this application</h2>\n<ol>\n<li><strong>Select a PNG image</strong> from your computer.</li>\n<li><strong>Choose the hexagon size</strong> using the slider.</li>\n<li><strong>Click Convert image</strong> to start the conversion.</li>\n<li><strong>Download the generated SVG file</strong>.</li>\n</ol>\n<hr />\n<span class=\"paragraph\"><em>Adjust the hexagon size to change the level of detail in the result.</em></span></span>"
          }
        }
      ],
      "console": []
